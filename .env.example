# Anthropic is tried first. Without this key the app falls through to Groq.
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# The backup, used when Anthropic has no key or its call fails.
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Pin one provider and skip the chain: anthropic | groq | local.
# The scorer uses this to measure a single engine rather than whichever one
# happened to answer.
# AI_PROVIDER=anthropic
